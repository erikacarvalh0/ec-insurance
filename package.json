{
  "name": "ec-insurance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "test:domain": "node --test packages/*/src/*.test.mjs",
    "test:dashboard": "node --test apps/web/src/features/dashboard/*.test.mjs",
    "start:api": "node packages/api/src/start.mjs",
    "start:api:db": "node packages/api/src/start-prisma.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "preview:web": "node apps/web/src/preview.mjs",
    "dev:web": "vite apps/web --config apps/web/vite.config.mjs",
    "build:web": "vite build apps/web --config apps/web/vite.config.mjs",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "vite": "^6.3.5"
  }
}
