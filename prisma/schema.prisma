generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InsuranceType {
  AUTO
  RESIDENTIAL
  LIFE
  HEALTH
  BUSINESS
  TRAVEL
}

enum LeadStatus {
  RECEIVED
  PROCESSING
  QUOTED
  MANUAL_REVIEW
  CONTACTED
  COMPLETED
  CANCELLED
}

model Lead {
  id             String        @id @default(uuid())
  insuranceType  InsuranceType
  status         LeadStatus    @default(RECEIVED)
  contactName    String
  contactEmail   String
  contactPhone   String
  idempotencyKey String        @unique
  ownerId        String?
  teamId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  quotations     Quotation[]
  statusHistory  LeadStatusHistory[]
  assignmentHistory LeadAssignmentHistory[]

  @@index([status, createdAt])
  @@index([teamId, ownerId])
}

model Quotation {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  provider   String
  status     String
  simulated  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
}

enum UserRole {
  BROKER
  MANAGER
  ADMIN
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  role                   UserRole  @default(BROKER)
  teamId                 String?
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([teamId, role])
}

model LeadStatusHistory {
  id         String     @id @default(uuid())
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id])
  actorId    String
  fromStatus LeadStatus
  toStatus   LeadStatus
  createdAt  DateTime   @default(now())

  @@index([leadId, createdAt])
  @@index([actorId, createdAt])
}

model LeadAssignmentHistory {
  id String @id @default(uuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id])
  actorId String
  fromOwnerId String?
  toOwnerId String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model NotificationJob {
 id String @id @default(uuid())
 idempotencyKey String @unique
 subject String
 body String
 status String @default("PENDING")
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 leaseExpiresAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([status, nextAttemptAt])
 @@index([status, leaseExpiresAt])
}

model Invoice {
  id String @id @default(uuid())
  idempotencyKey String @unique
  amountCents BigInt
  currency String @default("BRL")
  status String @default("OPEN")
  createdAt DateTime @default(now())
  payments Payment[]
}

model Payment {
  id String @id @default(uuid())
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  idempotencyKey String @unique
  amountCents BigInt
  currency String @default("BRL")
  status String @default("PENDING")
  createdAt DateTime @default(now())
  transactions BillingTransaction[]
  @@index([invoiceId])
}

model BillingTransaction {
  id String @id @default(uuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  idempotencyKey String @unique
  amountCents BigInt
  currency String @default("BRL")
  status String @default("PENDING")
  createdAt DateTime @default(now())
  @@index([paymentId])
}

model RevokedSession {
  id String @id
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
